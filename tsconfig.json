{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@pm-studio/shared": ["./packages/shared/src/index.ts"],
      "@pm-studio/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/out", "packages/desktop"]
}
