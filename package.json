{
  "name": "pm-studio",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Windows 桌面端「项目管理 + 项目脚手架」一体化工具",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p packages/desktop/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "tsx packages/desktop/scripts/make-icons.ts",
    "pack:dir": "pnpm --filter @pm-studio/desktop pack:dir",
    "dist": "pnpm --filter @pm-studio/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "ulid": "^3.0.2"
  }
}
